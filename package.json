{
  "name": "8",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:offline": "vite build --config vite.offline.config.mjs && node scripts/prepare-offline-manifest.mjs",
    "build": "pnpm run build:offline && vite build && node scripts/prepare-sites-build.mjs",
    "build:share": "node scripts/prepare-share-public.mjs && vite build --mode share && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:media": "node --test tests/media-performance.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter-tight": "^5.2.8",
    "@fontsource/rajdhani": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "gsap": "^3.15.0",
    "motion": "^13.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
